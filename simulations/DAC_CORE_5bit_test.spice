** sch_path: /foss/designs/DAC_CORE_5bit/DAC_CORE_5bit_test.sch
**.subckt DAC_CORE_5bit_test
XMREF DAC_REF DAC_REF VDD VDD pfet_03v3 L=5u W=2u nf=1 ad='int((nf+1)/2) * W/nf * 0.18u' as='int((nf+2)/2) * W/nf * 0.18u' pd='2*int((nf+1)/2) * (W/nf + 0.18u)'
+ ps='2*int((nf+2)/2) * (W/nf + 0.18u)' nrd='0.18u / W' nrs='0.18u / W' sa=0 sb=0 sd=0
RES_DAC DAC_REF gnd {RES_DAC}
RES_OUT I_DAC gnd 100
V0 VDD b[0] {VDD*((dac_bit-2*floor(dac_bit/2)))}
VSUPPLY VDD gnd {VDD}
V1 VDD b[1] {VDD*((dac_bit-4*floor(dac_bit/4)>1))}
V2 VDD b[2] {VDD*((dac_bit-8*floor(dac_bit/8)>3))}
V3 VDD b[3] {VDD*((dac_bit-16*floor(dac_bit/16)>7))}
V4 VDD b[4] {VDD*((dac_bit-32*floor(dac_bit/32)>15))}
x1 DAC_REF VDD b[0] b[1] b[2] b[3] b[4] I_DAC DAC_CORE_5bit
**** begin user architecture code


.include /foss/pdks/gf180mcuD/libs.tech/ngspice/design.ngspice
.lib /foss/pdks/gf180mcuD/libs.tech/ngspice/sm141064.ngspice typical
.include /foss/designs/DAC_CORE_5bit/DAC_CORE_5bit.pex.spice




.param sw_stat_global=0
.param sw_stat_mismatch=1

.param VDD=3.3
.param RES_DAC=106k
.param dac_bit=31
.control

let dac_code = vector(32)
let i_out = vector(32)
let i = 0
while i <= 31
   alterparam dac_bit = $&i
   reset
   op
   let dac_code[$&i] = i
   let i_out[$&i] = v(i_dac) / 100
   let i = i + 1
end
plot i_out vs dac_code xlabel 'dac_bit (0-31)' ylabel 'I_DAC [A]'

.endc


**** end user architecture code
